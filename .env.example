# SpacetimeDB endpoint used by the browser client. Defaults target a local server
# started with `npm run stdb:start`. No API key or account is needed locally.
VITE_SPACETIMEDB_URI=ws://localhost:3000
VITE_SPACETIMEDB_DB=penumbra

# Room joined automatically on first load (override per-visit with ?room=<name>).
VITE_DEFAULT_ROOM=penumbra-demo

# --- Map reader (Python, offline). Not VITE_-prefixed, so Vite never exposes these to the browser.
VLM_PROVIDER=anthropic
VLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=replace-with-your-claude-api-key
# Optional OpenAI alternative:
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_VISION_MODEL=gpt-4.1-mini
